{
  "name": "lukas-university",
  "version": "0.1.0",
  "private": true,
  "description": "Výběr vysoké školy podle predikce IB – katalog programů, scénáře známek, vážené průměry",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "migrate": "node db/migrate.js",
    "setup": "npm install && cd client && npm install && cd .. && npm run migrate",
    "test": "node --test \"tests/**/*.test.*\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  }
}
