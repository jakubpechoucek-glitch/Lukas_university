# SQLite soubor
DATABASE_URL=./data/lukas.db

# JWT – v produkci dlouhý náhodný řetězec (Render ho vygeneruje)
JWT_SECRET=change-me-to-a-long-random-secret

BCRYPT_ROUNDS=10
PORT=3000
NODE_ENV=development

# Účty vytvořené při startu, pokud ještě neexistují: "Jméno|email|role;…" (role: parent | student)
# Skutečné e-maily sem NEPIŠTE – nastavte je jen v .env (lokálně) nebo na Renderu.
BOOTSTRAP_USERS=Rodič|rodic@example.com|parent;Student|student@example.com|student
# Dočasné heslo pro nové účty, při prvním přihlášení se musí změnit
INITIAL_PASSWORD=

# Přihlášení přes Rozcestník (Supabase). Výchozí hodnoty míří na rodinný projekt,
# klíč je veřejný publishable klíč – nastavovat jen při změně projektu.
# SUPABASE_URL=https://unoefgbzymlwwehgzusf.supabase.co
# SUPABASE_KEY=sb_publishable_...
# E-maily (oddělené čárkou), které se při prvním přihlášení přes Rozcestník založí jako student; ostatní členové jsou parent
SSO_STUDENT_EMAILS=

# Internal Assessment: AI kontrola výzkumné otázky a zprávy (bez klíče funguje jen Průvodce)
ANTHROPIC_API_KEY=
# Volitelně jiný model (výchozí claude-sonnet-5-5)
# ANTHROPIC_MODEL=
