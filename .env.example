# SQLite soubor
DATABASE_URL=./data/lukas.db

# JWT – v produkci dlouhý náhodný řetězec (Render ho vygeneruje)
JWT_SECRET=change-me-to-a-long-random-secret

BCRYPT_ROUNDS=10
PORT=3000
NODE_ENV=development

# Účty vytvořené při startu, pokud ještě neexistují: "Jméno|email|role;…" (role: parent | student)
# Skutečné e-maily sem NEPIŠTE – nastavte je jen v .env (lokálně) nebo na Renderu.
BOOTSTRAP_USERS=Rodič|rodic@example.com|parent;Student|student@example.com|student
# Dočasné heslo pro nové účty, při prvním přihlášení se musí změnit
INITIAL_PASSWORD=
